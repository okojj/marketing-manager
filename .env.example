# Used by Docker Compose and backend. Do not commit .env.
MYSQL_DATABASE=marketing
MYSQL_USER=marketing
MYSQL_PASSWORD=marketing_local_change_me
MYSQL_ROOT_PASSWORD=root_local_change_me
MYSQL_PORT=3307
DB_HOST=127.0.0.1
DB_PORT=3307
FRONTEND_PORT=3100
BACKEND_PORT=3200
# local mode: docker (default) or external (use DB_HOST/DB_PORT)
LOCAL_DB_MODE=docker

# Google OAuth (Web application); see docs/google-login.md
APP_ORIGIN=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
COOKIE_SECURE=false

# AI ideas and content drafts
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30

# Ollama: use an already downloaded model (ollama list)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=240
